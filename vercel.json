{
  "version": 2,
  "buildCommand": "cd vercel-landing && npm install && npm run build",
  "outputDirectory": "vercel-landing",
  "framework": null,
  "installCommand": "cd vercel-landing && npm install",
  "headers": [
    {
      "source": "/extension.zip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).zip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
