{
  "version": 2,
  "buildCommand": "cd vercel-landing && npm install && npm run build",
  "outputDirectory": "vercel-landing",
  "framework": null,
  "installCommand": "cd vercel-landing && npm install",
  "rewrites": [
    { "source": "/api/auth/signup", "destination": "/api/auth/signup" },
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/auth/user", "destination": "/api/auth/user" },
    { "source": "/api/macros/sync", "destination": "/api/macros/sync" },
    { "source": "/api/macros/shared", "destination": "/api/macros/shared" },
    { "source": "/api/version-check", "destination": "/api/version-check" },
    { "source": "/api/extension-info", "destination": "/api/extension-info" }
  ],
  "headers": [
    {
      "source": "/extension.zip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
